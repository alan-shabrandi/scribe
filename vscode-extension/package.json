{
  "name": "scribe-vscode",
  "displayName": "Scribe - AI Commit Message Generator",
  "description": "Generate clean, conventional Git commit messages automatically using AI (OpenAI, Claude, Gemini, Ollama).",
  "publisher": "alan-shabrandi",
  "author": {
    "name": "Alan Shabrandi",
    "url": "https://alan-shabrandi.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/alan-shabrandi/scribe#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/alan-shabrandi/scribe.git"
  },
  "bugs": {
    "url": "https://github.com/alan-shabrandi/scribe/issues"
  },
  "qna": "marketplace",
  "keywords": [
    "git",
    "commit",
    "ai",
    "conventional commits",
    "commit message generator",
    "openai",
    "claude",
    "gemini",
    "ollama",
    "source control",
    "git commit",
    "scribe"
  ],
  "icon": "icon.png",
  "version": "1.3.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "SCM Providers",
    "AI",
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "scribe.generate",
        "title": "Scribe: Generate Commit Message",
        "icon": "$(git-pull-request-create)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "scribe.generate",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
